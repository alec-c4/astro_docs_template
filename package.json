{
	"name": "astro_docs_template",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"test": "node --test tests/*.test.ts",
		"test:e2e": "playwright test",
		"check": "astro check",
		"verify": "npm test && npm run format:check && npm run check && npm run build && npm run test:e2e",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"hooks:install": "lefthook install",
		"hooks:check": "lefthook run pre-commit --force"
	},
	"dependencies": {
		"@astrojs/mdx": "^8.1.5",
		"astro": "^7.4.11",
		"mermaid": "^12.3.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@playwright/test": "^1.65.0",
		"@types/node": "^26.6.6",
		"lefthook": "^2.2.2",
		"prettier": "^3.10.1",
		"prettier-plugin-astro": "^1.1.2",
		"typescript": "^6.0.3"
	},
	"allowScripts": {
		"lefthook": true
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/alec-c4/astro_docs_template.git"
	}
}
