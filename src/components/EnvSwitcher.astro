---
import { translations } from '../lib/i18n';
import { portal } from '../portal.config';
interface Props {
	envs: string[];
	defaultEnv?: string;
}
const { envs, defaultEnv } = Astro.props;
const t = translations(portal.locale);
---

<div data-env-switcher data-default={defaultEnv}>
	<div data-tabs role="tablist" aria-label={t.environment} hidden>
		{envs.map((env) => (
			<button
				type="button"
				role="tab"
				data-env={env}
				aria-selected="false"
				tabindex="-1"
			>
				{env}
			</button>
		))}
	</div>
	<div data-panels>
		<slot />
	</div>
</div>
<script>
	import { resolveEnv } from '../lib/environment';
	document
		.querySelectorAll<HTMLElement>('[data-env-switcher]')
		.forEach((root, index) => {
			const tabs = [
				...root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
			];
			const panels = [
				...root.querySelectorAll<HTMLElement>('[data-panels] > [data-env]'),
			];
			const envs = tabs.map((tab) => tab.dataset.env!);
			function select(env: string | undefined, focus = false) {
				tabs.forEach((tab, i) => {
					const active = tab.dataset.env === env;
					tab.id = `env-${index}-tab-${i}`;
					tab.setAttribute('aria-controls', `env-${index}-panel-${i}`);
					tab.setAttribute('aria-selected', String(active));
					tab.tabIndex = active ? 0 : -1;
					if (active && focus) tab.focus();
				});
				panels.forEach((panel) => {
					const i = envs.indexOf(panel.dataset.env!);
					panel.id = `env-${index}-panel-${i}`;
					panel.setAttribute('role', 'tabpanel');
					panel.setAttribute('aria-labelledby', `env-${index}-tab-${i}`);
					panel.tabIndex = 0;
					panel.hidden = panel.dataset.env !== env;
				});
			}
			if (!tabs.length) return;
			root.querySelector<HTMLElement>('[data-tabs]')!.hidden = false;
			select(
				resolveEnv(
					new URLSearchParams(location.search).get('env'),
					envs,
					root.dataset.default,
				),
			);
			tabs.forEach((tab, i) => {
				tab.addEventListener('click', () => select(tab.dataset.env));
				tab.addEventListener('keydown', (event) => {
					const offset = getComputedStyle(root).direction === 'rtl' ? -1 : 1;
					const positions: Record<string, number> = {
						ArrowRight: (i + offset + tabs.length) % tabs.length,
						ArrowLeft: (i - offset + tabs.length) % tabs.length,
						Home: 0,
						End: tabs.length - 1,
					};
					if (!(event.key in positions)) return;
					event.preventDefault();
					select(envs[positions[event.key]], true);
				});
			});
		});
</script>
