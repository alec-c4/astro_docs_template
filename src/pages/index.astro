---
import Portal from '../layouts/Portal.astro';
import { portal } from '../portal.config';
import { getDocs, href } from '../lib/docs';
import { translations } from '../lib/i18n';
const docs = await getDocs();
const t = translations(portal.locale);
---

<Portal title={t.home} description={portal.description}>
	<div class="section-grid">
		{portal.sections.map((section, i) => (
			<section class="section-card">
				<span class="section-number" aria-hidden="true">
					0{i + 1}
				</span>
				<h2>{section.label[portal.locale]}</h2>
				<ul>
					{docs
						.filter((doc) => doc.data.section === section.id)
						.map((doc) => (
							<li>
								<a href={href(doc.id)}>
									{doc.data.title}
									<span aria-hidden="true">↗</span>
								</a>
								<p>{doc.data.description}</p>
							</li>
						))}
				</ul>
			</section>
		))}
	</div>
</Portal>
